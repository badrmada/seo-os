# Environment files
.env
.env.*
*.env
*.env.*

# ...except the committed sample. deploy/compose/README.md tells you to copy it,
# so it has to survive a clone; it holds names and defaults, never a value.
!.env.example
!**/.env.example

# Virtual environments and local Python environments
.venv/
venv/
env/
ENV/
virtualenv/
.python-version

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Build, packaging, and dependency artifacts
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Local data and runtime artifacts
DA_store/
**/DA_store/
*.log
*.sqlite3
*.db

# Editor and OS junk files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Tenant workspaces — real configs, credentials, data, and run output.
# A tenant is a folder here (see services/seo-agents/docs/cli.md).
userdata/

# Credentials, wherever they land. Real ones live under userdata/ (ignored
# above); this is the backstop for a key file dropped somewhere else.
**/service_account.json