# Copy to .env next to docker-compose.yml. Every value here has a working
# default in the compose file; this exists to name what is worth changing.

# Where images come from. The default is this project's GHCR namespace, which
# `.github/workflows/images.yml` publishes to on every push to main.
IMAGE_REPO=ghcr.io/badrmada/seo-os
IMAGE_TAG=latest

# The tenant workspace on the host, mounted at /userdata. A tenant is a folder
# inside it; the container is told about the folder, never about the tenant.
# This path holds real configs and credentials — it is gitignored, and it is the
# reason userdata/ is in .dockerignore too.
USERDATA_PATH=./userdata

REDIS_PORT=6379
